{
  "name": "lively-darwin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run test:custom && npm run test:boosters && npm run boosters:audit && npm run test:extension && npm run test:polish && npm run test:cg && npm run cg:manifest:check && npm run test:melee && npm run test:stages && npm run test:noncombat-trials && npm run melee:sprites:audit && npm run portals:audit && npm run portals:prompts -- --check && npm run cosmetics:audit && npm run test:campaign && npm run test:oc-dlc && npm run test:original-universes && npm run audit:oc-dlc && npm run audit:original-universes && npm run check:progression",
    "build": "vite build",
    "lint": "oxlint",
    "check:progression": "node scripts/progressionAudit.mjs",
    "test:boosters": "node --test scripts/portalBoosterEngine.test.mjs scripts/portalBoosterCatalog.test.mjs scripts/portalBoosterEconomy.test.mjs scripts/universeUnlockables.test.mjs scripts/canonRosterBoosterArt.test.mjs scripts/canonRosterBoosterCatalogCoverage.test.mjs",
    "test:extension": "node --test scripts/cardCatalog.test.mjs scripts/cardCollectionEngine.test.mjs scripts/cardSaveMigration.test.mjs scripts/missionAccessRules.test.mjs scripts/missionStageProjection.test.mjs scripts/missionReplayPolicy.test.mjs scripts/arcReplayMigration.test.mjs scripts/portalVisualManifest.test.mjs scripts/portalVisualCatalog.test.mjs scripts/gameCanvasCosmeticPresentation.test.mjs",
    "test:polish": "node --test scripts/audioPreferences.test.mjs scripts/soundEngineGesture.test.mjs scripts/cloudSaveConflictPolicy.test.mjs scripts/titleNavigation.test.mjs scripts/titlePresentation.test.mjs",
    "test:cg": "node --test scripts/cgCatalog.test.mjs scripts/cgAssets.test.mjs scripts/cgManifest.test.mjs",
    "cg:assets:process": "node scripts/processCgPilotAssets.mjs --only-missing",
    "cg:assets:process:missing": "node scripts/processCgPilotAssets.mjs --only-missing",
    "cg:assets:refresh:stale": "node scripts/processCgPilotAssets.mjs --refresh-stale",
    "cg:assets:rebuild": "node scripts/processCgPilotAssets.mjs",
    "cg:manifest": "node scripts/buildCgManifest.mjs",
    "cg:manifest:check": "node scripts/buildCgManifest.mjs --check",
    "cg:review:variants": "node scripts/buildCgVariantReviewSheet.mjs",
    "test:melee": "node --test scripts/meleeInputMap.test.mjs scripts/meleeStateMachine.test.mjs scripts/meleeAnimationManifest.test.mjs scripts/meleeCombatRuntime.test.mjs",
    "test:stages": "node --test scripts/stageTopologyCatalog.test.mjs scripts/stageEventEngine.test.mjs",
    "test:noncombat-trials": "node --test scripts/nonCombatTrial.test.mjs scripts/canonRosterWave.test.mjs scripts/canonRosterWaveExpansion.test.mjs scripts/canonRosterNewBatch.test.mjs",
    "melee:sprites:audit": "node scripts/meleeSpriteAudit.mjs",
    "test:portals": "node --test scripts/portalVisualManifest.test.mjs scripts/portalVisualCatalog.test.mjs",
    "test:campaign": "node --test scripts/ocCampaign.test.mjs",
    "test:oc-dlc": "node scripts/ocDlcCatalog.test.mjs",
    "test:original-universes": "node --test scripts/originalUniverses.test.mjs scripts/originalUniverseIntegration.test.mjs",
    "test:custom": "node --test scripts/customBattle.test.mjs",
    "boosters:audit": "node scripts/portalBoosterAudit.mjs && node scripts/portalBoosterRemediationAudit.mjs",
    "items:audit": "node scripts/itemAssetAudit.mjs",
    "gear-shop:audit": "node scripts/gearShopAudit.mjs --strict",
    "cosmetics:sync": "node scripts/syncCosmeticVisualCatalog.mjs",
    "test:cosmetics": "node --test scripts/cosmeticVisualCatalog.test.mjs",
    "cosmetics:audit": "node scripts/cosmeticVisualAudit.mjs",
    "music:audit": "node scripts/stageMusicAudit.mjs",
    "audit:oc-dlc": "node scripts/ocDlcAssetsAudit.mjs",
    "audit:original-universes": "node scripts/originalUniverseImageV2Audit.mjs",
    "visuals:original-universes": "node scripts/buildOriginalUniverseImagePlan.mjs",
    "sprites:prompts": "node scripts/buildSpritePromptPack.mjs",
    "visuals:prompts": "node scripts/buildFeaturedVisualPromptPack.mjs",
    "portals:prompts": "node scripts/buildPortalPromptManifest.mjs",
    "portals:audit": "node scripts/portalVisualAudit.mjs",
    "textures:prompts": "node scripts/buildRecentUniverseTexturePromptPack.mjs",
    "textures:references": "node scripts/buildRecentUniverseTexturePromptPack.mjs --download-references",
    "textures:tactics-prompts": "node scripts/buildTacticsPerspectivePromptPack.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "sharp": "^0.35.3",
    "vite": "^8.1.0"
  }
}
